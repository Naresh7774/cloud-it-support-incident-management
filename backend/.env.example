# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production_with_32_plus_random_chars

# MySQL Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=incident_user
DB_PASSWORD=incident_secure_password
DB_NAME=incident_management
DB_CONNECTION_LIMIT=10

# AWS CloudWatch Logging (Optional for local, enabled on EC2)
ENABLE_CLOUDWATCH=false
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=/aws/ec2/cloud-incident-management
CLOUDWATCH_LOG_STREAM=app-instance-1
# Leave keys blank on EC2 to automatically use IAM Instance Profile
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Rate Limiting
RATE_LIMIT_MAX=500
