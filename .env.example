# ==============================================================
# Cloud IT Support & Incident Management System Environment Variables
# ==============================================================

# Application Environment
NODE_ENV=production
CORS_ORIGIN=http://localhost,http://localhost:80

# Port configuration (Nginx exposed externally on 80)
PORT=5000

# Security - JWT Token Encryption Secret
# Replace in production with a strong random 64-character secret
JWT_SECRET=replace_with_a_long_random_jwt_secret_in_production_min_32_characters

# Database Credentials
DB_NAME=incident_management
DB_USER=incident_user
DB_PASSWORD=incident_pass_change_in_prod
MYSQL_ROOT_PASSWORD=root_secure_password_change_in_prod

# AWS CloudWatch Logging (Set ENABLE_CLOUDWATCH=true on AWS EC2)
ENABLE_CLOUDWATCH=false
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=/aws/ec2/cloud-incident-management
CLOUDWATCH_LOG_STREAM=app-production-stream
# On EC2 with IAM Instance Profile, leave these empty:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
